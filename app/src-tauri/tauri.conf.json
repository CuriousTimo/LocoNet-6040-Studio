{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocoNet 6040 Studio",
  "identifier": "io.github.curioustimo.loconet-6040-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocoNet 6040 Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0E1014",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Set up Märklin Keyboards 6040 on LocoNet",
    "copyright": "Curious Timo"
  }
}
